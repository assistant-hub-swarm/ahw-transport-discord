# The Discord transport is stateless: no database. Everything else it needs
# (bot tokens, which assistants to run) comes from the core at registration.

# Redis (bus + update queue) — the core's compose `redis` service in dev.
REDIS_URL=redis://localhost:6379

# This service's HTTP surface (health, sends, menus, MCP). The token must
# match the core's INTERNAL_API_TOKEN.
# PORT=3220
INTERNAL_API_TOKEN=change-me

# The core's internal API (registration, desired state, menu presses).
# CORE_API_URL=http://localhost:3200

# The base URL this service announces at registration — what the CORE uses to
# reach it. Defaults to http://localhost:<PORT>; set it when the core cannot
# reach this service on localhost (compose: http://discord:3220).
# SELF_URL=http://localhost:3220
